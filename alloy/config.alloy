logging {
  level  = "info"
  format = "logfmt"
}

// Alloy junta solo los LOGS. Las métricas van por otro camino: las pide
// Prometheus a sus exportadores (ver prometheus/prometheus.yml).

// ---------- LOGS: las dos puntas de la conversación RADIUS ----------
// Cuando algo falla hay que mirar el log del router y el del RADIUS. Los dos
// entran por la misma puerta (syslog) y quedan juntos en Loki, cada uno con
// su etiqueta "job".
loki.source.syslog "router" {
  // El router manda sus logs acá (mikrotik/03-monitoreo.rsc)
  listener {
    address       = "0.0.0.0:1514"
    protocol      = "udp"
    syslog_format = "rfc3164"
    labels        = { job = "mikrotik-syslog" }
  }
  // Docker manda acá, desde isp-servicios, lo que escribe el contenedor de
  // FreeRADIUS (ver el bloque "logging" de ese servicio en docker-compose.yml).
  listener {
    address       = "0.0.0.0:1515"
    protocol      = "udp"
    syslog_format = "rfc3164"
    labels        = { job = "freeradius" }
  }
  relabel_rules = loki.relabel.syslog.rules
  forward_to    = [loki.write.local.receiver]
}

// Las etiquetas internas __syslog_* se descartan si no se copian:
// guardamos equipo, severidad y facility como etiquetas de Loki.
loki.relabel "syslog" {
  forward_to = []
  rule {
    source_labels = ["__syslog_message_hostname"]
    target_label  = "host"
  }
  rule {
    source_labels = ["__syslog_message_severity"]
    target_label  = "level"
  }
  rule {
    source_labels = ["__syslog_message_facility"]
    target_label  = "facility"
  }
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
