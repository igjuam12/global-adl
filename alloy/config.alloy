logging {
  level  = "info"
  format = "logfmt"
}

// ---------- MÉTRICAS: SNMP al router ----------
// snmp_exporter incorporado. "merge" suma nuestra comunidad (lab_v2)
// a los módulos que Alloy ya trae, en vez de reemplazarlos.
prometheus.exporter.snmp "router" {
  config_file           = "/etc/alloy/snmp-auths.yml"
  config_merge_strategy = "merge"

  target "isp_router" {
    address = "10.10.50.1"
    module  = "system,if_mib,hrDevice,hrStorage"
    auth    = "lab_v2"
  }
}

// Cada 15 s le pide los valores al exporter...
prometheus.scrape "router" {
  targets         = prometheus.exporter.snmp.router.targets
  forward_to      = [prometheus.remote_write.local.receiver]
  job_name        = "mikrotik-snmp"
  scrape_interval = "15s"
  scrape_timeout  = "10s"
}

// ...y los escribe en Prometheus.
prometheus.remote_write "local" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

// ---------- LOGS: syslog del router ----------
loki.source.syslog "router" {
  listener {
    address       = "0.0.0.0:1514"
    protocol      = "udp"
    syslog_format = "rfc3164"
    labels        = { job = "mikrotik-syslog" }
  }
  relabel_rules = loki.relabel.syslog.rules
  forward_to    = [loki.write.local.receiver]
}

// Las etiquetas internas __syslog_* se descartan si no se copian:
// guardamos equipo, severidad y facility como etiquetas de Loki.
loki.relabel "syslog" {
  forward_to = []
  rule {
    source_labels = ["__syslog_message_hostname"]
    target_label  = "host"
  }
  rule {
    source_labels = ["__syslog_message_severity"]
    target_label  = "level"
  }
  rule {
    source_labels = ["__syslog_message_facility"]
    target_label  = "facility"
  }
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
